# PostgreSQL connection string used by Prisma for the Contact form and
# Newsletter signup. The rest of the site (products, blog, testimonials)
# uses static demo data and needs no database.
#
# Local Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wovenest?schema=public"
#
# Hosted options that work great with Vercel: Neon, Supabase, Railway, Vercel Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/wovenest?schema=public"

# WhatsApp number for the floating chat button and Contact page CTA.
# Digits only, with country code, no + or spaces (e.g. 8801234567890).
NEXT_PUBLIC_WHATSAPP_NUMBER="8801234567890"

# Public site URL, used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
